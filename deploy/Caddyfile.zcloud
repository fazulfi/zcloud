# zcloud Caddy reverse proxy (production) — reference config; host nginx serves in practice
# Access: https://app.zrouter.dev (SPA) / https://api.zrouter.dev (API) — TLS at Cloudflare
# SSE note: Caddy does not buffer by default → safe for streaming relays.

{
	servers {
		max_header_size 64KB
		read_header_timeout 10s
		idle_timeout 2m
	}
}

api.zrouter.dev {
	encode zstd gzip
	reverse_proxy 127.0.0.1:18080 {
		health_uri /health
		health_interval 30s
		health_timeout 10s
		health_status 200
		lb_policy round_robin
		lb_try_duration 5s
		lb_try_interval 250ms
	}
}

app.zrouter.dev {
	encode zstd gzip
	reverse_proxy 127.0.0.1:18080 {
		health_uri /health
		health_interval 30s
		health_timeout 10s
		health_status 200
		lb_policy round_robin
		lb_try_duration 5s
		lb_try_interval 250ms
	}
}

zrouter.dev {
	encode zstd gzip
	reverse_proxy 127.0.0.1:18080 {
		health_uri /health
		health_interval 30s
		health_timeout 10s
		health_status 200
	}
}
