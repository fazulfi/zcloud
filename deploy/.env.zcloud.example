# zcloud zrouter environment — copy to .env.zcloud and set secrets
# Staging: zrouter.82.25.62.204.sslip.io | Production: zrouter.dev

# --- Server ---
# Browser frontend origins (comma-separated; required for direct Vercel API calls)
CORS_ALLOWED_ORIGINS=https://app.zrouter.dev,https://zrouter.82.25.62.204.sslip.io
SERVER_HOST=0.0.0.0
SERVER_PORT=18080
SERVER_MODE=release
RUN_MODE=standard
AUTO_SETUP=true
ENABLE_SERVER_TIMING=false
TZ=Asia/Singapore
ZCLOUD_VERSION=0.1.183-zcloud

# --- Database (staging = VPS host PG 127.0.0.1:5432; prod = managed PG) ---
DATABASE_HOST=host.docker.internal
DATABASE_PORT=5432
DATABASE_USER=zcloud
DATABASE_PASSWORD=CHANGE_ME
DATABASE_NAME=zcloud
DATABASE_SSLMODE=disable
DATABASE_MAX_OPEN_CONNS=50
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME_MINUTES=30
DATABASE_CONN_MAX_IDLE_TIME_MINUTES=5

# --- Redis (staging = VPS host Redis db 2; prod = managed Redis) ---
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=2
REDIS_POOL_SIZE=1024
REDIS_MIN_IDLE_CONNS=10
REDIS_ENABLE_TLS=false

# --- Admin bootstrap (owner account, D20) ---
ADMIN_EMAIL=owner@zrouter.dev
ADMIN_PASSWORD=CHANGE_ME_STRONG

# --- Secrets (MANDATORY — rotate before prod) ---
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_EXPIRE_HOUR=24
TOTP_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32

# --- Supplier: InferHub (D10 — cb/ cbcn/ cx/ only) ---
INFERHUB_API_KEY=sk-airo-CHANGE_ME
INFERHUB_BASE_URL=https://api.inferhub.dev
INFERHUB_MANAGEMENT_BASE_URL=https://inferhub.dev/api
INFERHUB_MANAGEMENT_RATE_LIMIT_PER_MIN=30

# --- USDT TRC20 wallet (D5, M1.4) ---
TRON_API_URL=https://api.trongrid.io
TRON_API_KEY=CHANGE_ME
USDT_CONFIRMATIONS_REQUIRED=19
USDT_POLL_INTERVAL_SECONDS=15
WALLET_HOT_ADDRESS=CHANGE_ME
WALLET_COLD_ADDRESS=CHANGE_ME

# --- Notifications (D21 — Telegram only) ---
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_ADMIN_CHAT_ID=CHANGE_ME

# --- Support (D24) ---
SUPPORT_EMAIL=support@zrouter.dev
SMTP_FROM=support@zrouter.dev
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME

# --- Non-MVP features (D22 — disabled) ---
ENABLE_REDEEM_CODES=false
ENABLE_PROMO_CODES=false
ENABLE_AFFILIATE=false
ENABLE_ANNOUNCEMENTS=false
ENABLE_BATCH_IMAGE=false

# --- Gateway tuning (07-sla) ---
GATEWAY_MAX_BODY_SIZE=268435456
GATEWAY_MAX_CONNS_PER_HOST=1024
GATEWAY_MAX_IDLE_CONNS=2560
GATEWAY_MAX_IDLE_CONNS_PER_HOST=120
